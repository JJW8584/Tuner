<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ retains a system starting window. Keep it plain and avoid
         the default launcher-icon splash; never add an artificial hold. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">#030404</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/empty_splash_icon</item>
        <item name="android:windowSplashScreenIconBackgroundColor">#030404</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
        <item name="android:windowSplashScreenBrandingImage">@drawable/empty_splash_icon</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">#030404</item>
    </style>
</resources>
